{
  "nvim_version": "0.12.6",
  "cases": [
    {
      "name": "3x deletes three",
      "before": "abcdef",
      "cursor": [0, 0],
      "keys": "3x",
      "expect": {
        "text": "def",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "abc"
      }
    },
    {
      "name": "2dd deletes two lines",
      "before": "a\nb\nc",
      "cursor": [0, 0],
      "keys": "2dd",
      "expect": {
        "text": "c",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "a\nb\n"
      }
    },
    {
      "name": "Del erases the typed count",
      "before": "abcdef",
      "cursor": [0, 0],
      "keys": "3<Del>x",
      "expect": {
        "text": "bcdef",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "a"
      }
    },
    {
      "name": "Del erases the last count digit",
      "before": "abcdefghijklmnop",
      "cursor": [0, 0],
      "keys": "12<Del>x",
      "expect": {
        "text": "bcdefghijklmnop",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "a"
      }
    },
    {
      "name": "Del erases the operator count digit",
      "before": "a b c d e f",
      "cursor": [0, 0],
      "keys": "d23<Del>w",
      "expect": {
        "text": "c d e f",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "a b "
      }
    }
  ]
}
