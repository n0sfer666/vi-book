{
  "nvim_version": "0.12.6",
  "cases": [
    {
      "name": "dw deletes word",
      "before": "one two",
      "cursor": [0, 0],
      "keys": "dw",
      "expect": {
        "text": "two",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "one "
      }
    },
    {
      "name": "cw mid-word",
      "before": "hello world",
      "cursor": [0, 2],
      "keys": "cwX<Esc>",
      "expect": {
        "text": "heX world",
        "cursor": [0, 2],
        "mode": "normal",
        "unnamed": "llo"
      }
    },
    {
      "name": "dd middle line",
      "before": "a\nb\nc",
      "cursor": [1, 0],
      "keys": "dd",
      "expect": {
        "text": "a\nc",
        "cursor": [1, 0],
        "mode": "normal",
        "unnamed": "b\n"
      }
    },
    {
      "name": "x at line end",
      "before": "abc",
      "cursor": [0, 2],
      "keys": "x",
      "expect": {
        "text": "ab",
        "cursor": [0, 1],
        "mode": "normal",
        "unnamed": "c"
      }
    },
    {
      "name": "Del deletes char under cursor",
      "before": "abc",
      "cursor": [0, 1],
      "keys": "<Del>",
      "expect": {
        "text": "ac",
        "cursor": [0, 1],
        "mode": "normal",
        "unnamed": "b"
      }
    },
    {
      "name": "Del on last char moves cursor left",
      "before": "abc",
      "cursor": [0, 2],
      "keys": "<Del>",
      "expect": {
        "text": "ab",
        "cursor": [0, 1],
        "mode": "normal",
        "unnamed": "c"
      }
    },
    {
      "name": "d End deletes to line end",
      "before": "abc def",
      "cursor": [0, 2],
      "keys": "d<End>",
      "expect": {
        "text": "ab",
        "cursor": [0, 1],
        "mode": "normal",
        "unnamed": "c def"
      }
    },
    {
      "name": "y Home yanks to line start",
      "before": "abc def",
      "cursor": [0, 4],
      "keys": "y<Home>",
      "expect": {
        "text": "abc def",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "abc "
      }
    },
    {
      "name": "c End changes to line end",
      "before": "abc def",
      "cursor": [0, 4],
      "keys": "c<End>X<Esc>",
      "expect": {
        "text": "abc X",
        "cursor": [0, 4],
        "mode": "normal",
        "unnamed": "def"
      }
    },
    {
      "name": "d Left deletes char before",
      "before": "abc",
      "cursor": [0, 2],
      "keys": "d<Left>",
      "expect": {
        "text": "ac",
        "cursor": [0, 1],
        "mode": "normal",
        "unnamed": "b"
      }
    },
    {
      "name": "d Down deletes two lines",
      "before": "a\nb\nc",
      "cursor": [0, 0],
      "keys": "d<Down>",
      "expect": {
        "text": "c",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "a\nb\n"
      }
    },
    {
      "name": "d Up deletes two lines",
      "before": "a\nb\nc",
      "cursor": [2, 0],
      "keys": "d<Up>",
      "expect": {
        "text": "a",
        "cursor": [0, 0],
        "mode": "normal",
        "unnamed": "b\nc\n"
      }
    },
    {
      "name": "d Del cancels the operator",
      "before": "abc",
      "cursor": [0, 1],
      "keys": "d<Del>",
      "expect": {
        "text": "abc",
        "cursor": [0, 1],
        "mode": "normal",
        "unnamed": ""
      }
    }
  ]
}
